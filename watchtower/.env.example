# Copy to .env and fill in for anything other than the local Anvil demo
# (`.env` is gitignored — never commit real private keys).

# RPC endpoint of the chain the PaymentChannel you're watching lives on.
WATCHTOWER_RPC_URL=http://127.0.0.1:8545

# Address of the PaymentChannel deployment to watch. No default — required.
WATCHTOWER_CONTRACT=

# HTTP port for the checkpoint API (POST /checkpoint).
WATCHTOWER_PORT=8787

# Submitting key for challenge() rescue transactions — needs ETH for gas
# only, no special permission (challenge() is not onlyParty, see
# PaymentChannel.sol). Falls back to Anvil's demo account #2 if unset (only
# correct for local Anvil).
# WATCHTOWER_PRIVATE_KEY=0x...

# Where to persist checkpoints. Defaults to ./checkpoints.json.
# WATCHTOWER_STORE_PATH=./checkpoints.json
