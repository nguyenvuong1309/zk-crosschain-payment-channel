# Copy to .env and fill in for anything other than the local Anvil demo
# (`.env` is gitignored — never commit real private keys).
#
# Local demo (chains/start_chain_a.sh + b.sh): leave everything unset, the
# scripts fall back to Anvil's well-known public demo keys automatically.
#
# Which chains exist (names, RPC env var names, whether each gets a light
# client) is defined in chains.config.json, not here — this file only fills
# in the ACTUAL values for whatever env vars that config references. Add a
# 3rd/4th chain by adding an entry to chains.config.json, then set its
# rpcEnv/deployerKeyEnv vars below.

# RPC endpoints for chainA / chainB (see chains.config.json's rpcEnv per
# chain). For a public testnet, use a provider like Alchemy or Infura (free
# tier is enough), e.g.:
#   CHAIN_A_RPC=https://eth-sepolia.g.alchemy.com/v2/<your-api-key>
CHAIN_A_RPC=http://127.0.0.1:8545
CHAIN_B_RPC=http://127.0.0.1:8546

# Deployer key(s) — used by `npm run deploy`. Falls back to
# DEPLOYER_PRIVATE_KEY for any chain without its own key set, then further
# falls back to Anvil's demo key if nothing is set at all (only correct for
# local Anvil — deploy.js/chains.js print a warning if it detects this
# combined with a non-localhost RPC).
# DEPLOYER_PRIVATE_KEY_A=0x...
# DEPLOYER_PRIVATE_KEY_B=0x...
# DEPLOYER_PRIVATE_KEY=0x...

# Relayer's own submitting key — used by `npm run relay` /
# `node src/index.js <channelId> [fromChain] [toChain]`. Needs ETH on the
# DESTINATION chain only (gas for updateState()); does NOT need any special
# permission, see LightClientVerifier.sol's doc comment.
# RELAYER_PRIVATE_KEY=0x...
